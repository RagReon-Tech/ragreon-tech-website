# RagReon Tech Official Website - Environment Variables

# Google Apps Script Web App Deployment URL (Contact Form)
# Format: https://script.google.com/macros/s/AKfycb.../exec
VITE_CONTACT_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: Formspree Form ID fallback (if not using Google Apps Script)
# VITE_FORMSPREE_ID=

# ===================================================================
# RagReon AI Assistant Configuration (Server-Side Only)
# NOTE: GEMINI_API_KEY is never exposed to the frontend browser bundle.
# ===================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Identifier (Default: gemini-3.8-flash)
# Confirmed supported models include: gemini-3.8-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Optional: External Assistant API URL (Only needed if backend is hosted on a separate domain from frontend)
# Default is relative: /api/assistant/chat
# VITE_ASSISTANT_API_URL=https://your-backend-api.vercel.app/api/assistant/chat
